{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AbstractIngredient Schema (Extended)",
  "description": "JSON Schema для импорта данных в модель AbstractIngredient с поддержкой данных из справочника Скурихина и Тутельяна",
  "type": "object",
  "required": ["name", "short_description", "description", "semantic_data", "data_source"],

  "properties": {
    "name": {
      "type": "string",
      "description": "Название ингредиента",
      "minLength": 1,
      "maxLength": 300
    },

    "name_normalized": {
      "type": "string",
      "description": "Нормализованное название для поиска (транслитерация)",
      "maxLength": 300
    },

    "synonyms": {
      "type": "string",
      "description": "Синонимы и альтернативные названия через запятую (например: томат, помидор)",
      "maxLength": 500
    },

    "short_description": {
      "type": "string",
      "maxLength": 500,
      "description": "Краткое описание для карточек (до 500 символов)"
    },

    "description": {
      "type": "string",
      "description": "Полное описание ингредиента с HTML-разметкой"
    },

    "category": {
      "type": "string",
      "description": "Категория ингредиента"
    },

    "semantic_data": {
      "type": "object",
      "description": "Структурированные семантические данные",
      "properties": {
        "properties": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Свойства ингредиента (например: растительный, белковый, жирный)"
        },
        "preparations": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Способы подготовки (например: очистка, мытье, нарезка)"
        },
        "cooking_methods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "description": "Название метода приготовления"
              },
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"],
                "description": "Приоритет метода"
              }
            },
            "required": ["method", "priority"]
          },
          "description": "Методы кулинарной обработки"
        },
        "applications": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Кулинарное применение (например: супы, салаты, выпечка)"
        },
        "pairings": {
          "type": "object",
          "description": "Сочетаемость с другими продуктами",
          "properties": {
            "protein": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Белковые продукты"
            },
            "vegetables": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Овощи"
            },
            "sauces": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Соусы"
            },
            "herbs": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Травы и зелень"
            },
            "spices": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Специи и пряности"
            }
          }
        },
        "substitutes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Название продукта-замены"
              },
              "similarity": {
                "type": "string",
                "enum": ["high", "medium", "low"],
                "description": "Степень схожести"
              }
            },
            "required": ["name", "similarity"]
          },
          "description": "Возможные замены ингредиента"
        }
      }
    },

    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Список семантических тегов"
    },

    "fdc_id": {
      "type": ["integer", "null"],
      "description": "Код продукта из справочника (FDC ID)",
      "minimum": 0
    },

    "source_table": {
      "type": "string",
      "description": "Номер таблицы в справочнике",
      "examples": ["1.1.1.1", "3.1.15.7"]
    },

    "source_page": {
      "type": ["integer", "null"],
      "description": "Номер страницы в PDF",
      "minimum": 1
    },

    "data_source": {
      "type": "string",
      "description": "Источник данных",
      "enum": [
        "skurikhin_tutelyan_2002",
        "health-diet.ru",
        "open_food_facts",
        "user_added"
      ],
      "default": "skurikhin_tutelyan_2002"
    },

    "data_source_reference": {
      "type": "string",
      "description": "Полная библиографическая ссылка на источник"
    },

    "is_active": {
      "type": "boolean",
      "description": "Активен ли ингредиент",
      "default": true
    },

    "portion": {
      "type": ["integer", "null"],
      "description": "Размер порции из справочника, г",
      "minimum": 0
    },

    "water": {
      "type": ["number", "null"],
      "description": "Содержание воды, %",
      "minimum": 0,
      "maximum": 100
    },

    "protein": {
      "type": ["number", "null"],
      "description": "Содержание белков, г",
      "minimum": 0
    },

    "fat": {
      "type": ["number", "null"],
      "description": "Содержание жиров, г",
      "minimum": 0
    },

    "carbohydrates": {
      "type": ["number", "null"],
      "description": "Содержание углеводов, г",
      "minimum": 0
    },

    "calories": {
      "type": ["number", "null"],
      "description": "Энергетическая ценность, ккал",
      "minimum": 0
    },

    "saturated_fat": {
      "type": ["number", "null"],
      "description": "Насыщенные жирные кислоты, г",
      "minimum": 0
    },

    "polyunsaturated_fat": {
      "type": ["number", "null"],
      "description": "Полиненасыщенные жирные кислоты, г",
      "minimum": 0
    },

    "cholesterol": {
      "type": ["number", "null"],
      "description": "Холестерин, мг",
      "minimum": 0
    },

    "sugar": {
      "type": ["number", "null"],
      "description": "Моно- и дисахариды (сахара), г",
      "minimum": 0
    },

    "starch": {
      "type": ["number", "null"],
      "description": "Крахмал, г",
      "minimum": 0
    },

    "fiber": {
      "type": ["number", "null"],
      "description": "Пищевые волокна, г",
      "minimum": 0
    },

    "organic_acids": {
      "type": ["number", "null"],
      "description": "Органические кислоты, г",
      "minimum": 0
    },

    "ash": {
      "type": ["number", "null"],
      "description": "Зола (минеральные вещества), г",
      "minimum": 0
    },

    "sodium": {
      "type": ["number", "null"],
      "description": "Натрий, мг",
      "minimum": 0
    },

    "potassium": {
      "type": ["number", "null"],
      "description": "Калий, мг",
      "minimum": 0
    },

    "calcium": {
      "type": ["number", "null"],
      "description": "Кальций, мг",
      "minimum": 0
    },

    "magnesium": {
      "type": ["number", "null"],
      "description": "Магний, мг",
      "minimum": 0
    },

    "phosphorus": {
      "type": ["number", "null"],
      "description": "Фосфор, мг",
      "minimum": 0
    },

    "iron": {
      "type": ["number", "null"],
      "description": "Железо, мг",
      "minimum": 0
    },

    "vitamin_a": {
      "type": ["number", "null"],
      "description": "Витамин А, мкг",
      "minimum": 0
    },

    "beta_carotene": {
      "type": ["number", "null"],
      "description": "Бета-каротин, мг",
      "minimum": 0
    },

    "vitamin_b1": {
      "type": ["number", "null"],
      "description": "Витамин B1 (тиамин), мг",
      "minimum": 0
    },

    "vitamin_b2": {
      "type": ["number", "null"],
      "description": "Витамин B2 (рибофлавин), мг",
      "minimum": 0
    },

    "vitamin_b3": {
      "type": ["number", "null"],
      "description": "Витамин B3 (ниацин, PP), мг",
      "minimum": 0
    },

    "vitamin_b4": {
      "type": ["number", "null"],
      "description": "Витамин B4 (холин), мг",
      "minimum": 0
    },

    "vitamin_b5": {
      "type": ["number", "null"],
      "description": "Витамин B5 (пантотеновая кислота), мг",
      "minimum": 0
    },

    "vitamin_b6": {
      "type": ["number", "null"],
      "description": "Витамин B6 (пиридоксин), мг",
      "minimum": 0
    },

    "vitamin_b7": {
      "type": ["number", "null"],
      "description": "Витамин B7 (биотин), мкг",
      "minimum": 0
    },

    "vitamin_b9_folate": {
      "type": ["number", "null"],
      "description": "Витамин B9 (фолаты), мкг",
      "minimum": 0
    },

    "vitamin_b12": {
      "type": ["number", "null"],
      "description": "Витамин B12 (кобаламин), мкг",
      "minimum": 0
    },

    "vitamin_c": {
      "type": ["number", "null"],
      "description": "Витамин C (аскорбиновая кислота), мг",
      "minimum": 0
    },

    "vitamin_d": {
      "type": ["number", "null"],
      "description": "Витамин D, мкг",
      "minimum": 0
    },

    "vitamin_e": {
      "type": ["number", "null"],
      "description": "Витамин E, мг",
      "minimum": 0
    },

    "vitamin_k": {
      "type": ["number", "null"],
      "description": "Витамин K, мкг",
      "minimum": 0
    },

    "retinol_equivalent": {
      "type": ["number", "null"],
      "description": "Ретиноловый эквивалент (РЭ), мкг",
      "minimum": 0
    },
    "niacin_equivalent": {
      "type": ["number", "null"],
      "description": "Ниациновый эквивалент (НЭ), мг",
      "minimum": 0
    }

  },

  "allOf": [
    {
      "if": {
        "properties": {
          "data_source": {
            "const": "skurikhin_tutelyan_2002"
          }
        }
      },
      "then": {
        "properties": {
          "data_source_reference": {
            "type": "string",
            "description": "Библиографическая ссылка на справочник",
            "const": "Химический состав российских пищевых продуктов : Справочник / Под ред. член-корр. МАИ, проф. И. М. Скурихина и академика РАМН, проф. В. А. Тутельяна. — М. : ДеЛи принт, 2002. — 236 с. — ISBN 5-94343-028-8."
          }
        }
      }
    }
  ]
}